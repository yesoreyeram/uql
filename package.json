    "@yesoreyeram/nearley": "^3.0.0-beta.2",
    "csv-parse": "4.12.0",
    "dayjs": "^1.10.7",
    "fast-xml-parser": "^4.2.4",
    "js-yaml": "^4.1.0",
    "jsonata": "1.8.7",
    "lodash": "^4.17.21",
    "moo": "^0.5.2",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "@types/jest": "29.5.11",
    "@types/js-yaml": "4.0.9",
    "@types/lodash": "4.14.202",
