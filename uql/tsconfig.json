{
  "compilerOptions": {
    "target": "es5",
    "lib": ["ES2021.String"],
    "types": ["node", "jest"],
    "typeRoots": ["../node_modules/@types"],
    "module": "commonjs",
    "declaration": true,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/__tests__/*"]
}
